root = true

[*]
end_of_line = lf

[*.bat]
end_of_line = crlf

# Third-party license texts and NuGet lock files are kept as published, with CRLF
[src/{mediaHelper,pipHelper}/{licenses/*,packages.lock.json}]
end_of_line = crlf

[*.java]
charset = utf-8
indent_style = space
indent_size = 4

[*.json]
charset = utf-8
indent_style = space
indent_size = 2
